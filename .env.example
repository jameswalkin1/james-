# Copy to .env and fill in. NEVER commit .env

# ---------------------------------------------------------------------------
# OANDA v20 REST API  (config.yaml -> broker: oanda)
# Create a demo account, then Manage API Access -> Generate token.
# NOTE: this requires an OANDA fxTrade (v20) account. An OANDA MetaTrader 5
# account will NOT work here - use the MT5 section below for that.
# ---------------------------------------------------------------------------
OANDA_API_TOKEN=your_token_here
OANDA_ACCOUNT_ID=101-004-12345678-001
OANDA_ENVIRONMENT=practice

# ---------------------------------------------------------------------------
# MetaTrader 5  (config.yaml -> broker: mt5)
# Works with Vantage, OANDA's MT5 accounts, IC Markets and others.
# Requires Windows with the MT5 terminal installed and running.
# Leave these blank to attach to a terminal that is already logged in.
# ---------------------------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# ---------------------------------------------------------------------------
# Optional: Telegram alerts. @BotFather for a token, @userinfobot for your id
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

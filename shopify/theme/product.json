            "accordion_sections": {
              "type": "accordion",
              "name": "t:names.accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "divider_color": "",
                "type_preset": "h6",
                "background_color": "",
                "text_color": "",
                "border": "none",

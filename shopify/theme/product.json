    "gallery_fit_css": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- assign hs_price = product.price | money -%}\n<style>\n  /* ---- Gallery -------------------------------------------------------\n     The theme hard-codes object-fit:cover whenever a fixed aspect ratio is\n     set (snippets/product-media-gallery-content.liquid). These images carry\n     text, so cropping cuts it off. Keep the uniform frame, letterbox inside. */\n  media-gallery .product-media-container :is(img, .deferred-media__poster-image) {\n    object-fit: contain !important;\n    background-color: var(--color-background);\n  }\n  media-gallery .product-media-container {\n    background-color: var(--color-background);\n    border: 1px solid #E5E5E3;\n    border-radius: 12px;\n    overflow: hidden;\n  }\n\n  /* ---- Quantity ------------------------------------------------------\n     Hidden on the product form only. The cart uses\n     cart-quantity-selector-component, so :has() leaves it untouched and\n     shoppers can still change quantity there. */\n  .quantity-selector-wrapper:has(quantity-selector-component) { display: none !important; }\n\n  /* ---- Add to cart ---------------------------------------------------- */\n  .add-to-cart-button {\n    width: 100% !important;\n    border-radius: 10px !important;\n    padding-block: 1.05rem;\n    font-size: 1.02rem;\n    font-weight: 700;\n    letter-spacing: 0;\n    box-shadow: 0 2px 0 rgba(17, 17, 17, .10);\n    transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease;\n  }\n  .add-to-cart-button:hover,\n  .add-to-cart-button:focus-visible {\n    transform: translateY(-2px);\n    box-shadow: 0 10px 24px rgba(217, 45, 32, .28);\n  }\n  .add-to-cart-button:active {\n    transform: translateY(0);\n    box-shadow: 0 2px 0 rgba(17, 17, 17, .10);\n  }\n  .hs-price-tag { font-weight: 700; opacity: .92; }\n\n  /* ---- Shop Pay, demoted --------------------------------------------\n     Shopify locks the purple, so it is made secondary by size and by\n     sitting under a labelled divider rather than by recolouring. */\n  .accelerated-checkout-block {\n    position: relative;\n    margin-top: 1.75rem;\n    padding-top: 1.6rem;\n    border-top: 1px solid #E5E5E3;\n    --shop-pay-button-height: 46px;\n    --shop-pay-button-border-radius: 10px;\n  }\n  .accelerated-checkout-block::before {\n    content: \"or check out with\";\n    position: absolute;\n    top: 0;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    background: var(--color-background);\n    padding: 0 .7rem;\n    font-size: .72rem;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    font-weight: 600;\n    color: #6B6B6B;\n    white-space: nowrap;\n  }\n  .shopify-payment-button__more-options {\n    font-size: .85rem;\n    color: #6B6B6B;\n    text-underline-offset: 3px;\n    margin-top: .6rem;\n  }\n  .shopify-payment-button__more-options:hover { color: #111111; }\n\n  /* ---- Accordion rows ------------------------------------------------- */\n  .accordion .details__header {\n    padding-block: 1.05rem;\n    cursor: pointer;\n    transition: color .18s ease;\n  }\n  .accordion .details__header:hover { color: #D92D20; }\n  .accordion .details-content > * { animation: hs-slide .32s cubic-bezier(.2,.7,.3,1) both; }\n  @keyframes hs-slide { from { opacity: 0; transform: translateY(-6px); } }\n\n  /* ---- Scroll reveal --------------------------------------------------- */\n  .hs-r {\n    opacity: 0;\n    transform: translateY(16px);\n    transition: opacity .6s cubic-bezier(.2,.7,.3,1), transform .6s cubic-bezier(.2,.7,.3,1);\n  }\n  .hs-r.is-in { opacity: 1; transform: none; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hs-r { opacity: 1; transform: none; transition: none; }\n    .accordion .details-content > * { animation: none; }\n    .add-to-cart-button { transition: none; }\n    .add-to-cart-button:hover { transform: none; }\n  }\n</style>\n\n<script>\n  (function () {\n    var PRICE = {{ hs_price | json }};\n    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n    /* Put the price inside the Add to cart button, and keep it there if the\n       theme re-renders the form after a variant or cart change. */\n    function labelPrice() {\n      document.querySelectorAll('.add-to-cart-button').forEach(function (btn) {\n        if (btn.querySelector('.hs-price-tag')) return;\n        if (btn.hasAttribute('disabled')) return;\n        var tag = document.createElement('span');\n        tag.className = 'hs-price-tag';\n        tag.textContent = ' — ' + PRICE;\n        btn.appendChild(tag);\n      });\n    }\n\n    function revealGallery() {\n      var els = document.querySelectorAll('media-gallery .product-media-container');\n      if (!els.length || reduce || !('IntersectionObserver' in window)) return;\n      var io = new IntersectionObserver(function (entries) {\n        entries.forEach(function (e) {\n          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }\n        });\n      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.1 });\n      els.forEach(function (el, i) {\n        if (i === 0) return;            /* never hide the first image */\n        el.classList.add('hs-r');\n        io.observe(el);\n      });\n    }\n\n    function start() {\n      labelPrice();\n      revealGallery();\n      var form = document.querySelector('product-form-component') || document.body;\n      if ('MutationObserver' in window) {\n        new MutationObserver(labelPrice).observe(form, { childList: true, subtree: true });\n      }\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', start);\n    } else { start(); }\n  })();\n</script>\n",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  },
  "order": [
    "gallery_fit_css",
    "main"
  ]
}
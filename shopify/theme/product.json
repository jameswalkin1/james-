    "gallery_fit_css": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  /* Uniform gallery frames without cropping. The theme hard-codes object-fit:cover\n     whenever a fixed aspect ratio is set (snippets/product-media-gallery-content.liquid).\n     These images are four different shapes and carry text, so cropping cuts it off. */\n  media-gallery .product-media-container :is(img, .deferred-media__poster-image) {\n    object-fit: contain !important;\n    background-color: var(--color-background);\n  }\n  media-gallery .product-media-container {\n    background-color: var(--color-background);\n    border: 1px solid #E2D6C6;\n    border-radius: 14px;\n    overflow: hidden;\n  }\n\n  /* Buy button lift, matching the homepage */\n  .shopify-payment-button__button,\n  product-form-component .button {\n    transition: transform .18s ease, box-shadow .18s ease;\n  }\n  .shopify-payment-button__button:hover,\n  product-form-component .button:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 8px 22px rgba(34, 32, 28, .18);\n  }\n\n  /* Scroll reveal */\n  .hs-r { opacity: 0; transform: translateY(16px);\n    transition: opacity .6s cubic-bezier(.2,.7,.3,1), transform .6s cubic-bezier(.2,.7,.3,1); }\n  .hs-r.is-in { opacity: 1; transform: none; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hs-r { opacity: 1; transform: none; transition: none; }\n    .shopify-payment-button__button, product-form-component .button { transition: none; }\n    .shopify-payment-button__button:hover,\n    product-form-component .button:hover { transform: none; }\n  }\n</style>\n\n<script>\n  (function () {\n    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    function start() {\n      var els = document.querySelectorAll('media-gallery .product-media-container');\n      if (!els.length) return;\n      if (reduce || !('IntersectionObserver' in window)) return;\n      var io = new IntersectionObserver(function (entries) {\n        entries.forEach(function (e) {\n          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }\n        });\n      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.1 });\n      els.forEach(function (el, i) {\n        if (i === 0) return;           /* never hide the first image */\n        el.classList.add('hs-r');\n        io.observe(el);\n      });\n    }\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', start);\n    } else { start(); }\n  })();\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }

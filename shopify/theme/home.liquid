{%- assign p = all_products['led-red-light-therapy-hair-growth-cap-with-infrared-heat'] -%}
{%- assign hero_img = p.images[2] | default: p.featured_image -%}

<div class="hs">
  <section class="hs-hero">
    <div class="hs-hero__glow" aria-hidden="true"></div>
    <div class="hs-hero__inner">
      <div class="hs-hero__copy hs-reveal">
        <p class="hs-eyebrow">Red + near-infrared light therapy</p>
        <h1 class="hs-h1">Wear it.<br>Get on with your day.</h1>
        <p class="hs-price">{{ p.price | money }}</p>
        <div class="hs-cta">
          <a class="hs-btn hs-btn--primary" href="{{ p.url }}">Buy now</a>
          <a class="hs-btn hs-btn--ghost" href="/pages/how-it-works">How it works</a>
        </div>
        <p class="hs-micro">Free delivery in Ireland &middot; 30-day returns</p>
      </div>
      <div class="hs-hero__media hs-reveal hs-reveal--slow">
        {% if hero_img %}
          <img src="{{ hero_img | image_url: width: 900 }}" width="900" alt="{{ hero_img.alt | escape }}" loading="eager">
        {% endif %}
      </div>
    </div>
  </section>

  <section class="hs-strip" aria-label="At a glance">
    <ul class="hs-strip__list">
      <li class="hs-reveal"><span class="hs-strip__n">100</span><span class="hs-strip__l">LEDs</span></li>
      <li class="hs-reveal"><span class="hs-strip__n">2</span><span class="hs-strip__l">Wavelengths</span></li>
      <li class="hs-reveal"><span class="hs-strip__n">3</span><span class="hs-strip__l">Intensity levels</span></li>
      <li class="hs-reveal"><span class="hs-strip__n">30</span><span class="hs-strip__l">Day returns</span></li>
    </ul>
  </section>

  <section class="hs-steps">
    <h2 class="hs-h2 hs-reveal">Three steps. That&rsquo;s the routine.</h2>
    <ol class="hs-steps__list">
      <li class="hs-reveal">
        <span class="hs-steps__num">01</span>
        <h3>Charge</h3>
        <p>One charge, then you&rsquo;re free of the socket.</p>
      </li>
      <li class="hs-reveal">
        <span class="hs-steps__num">02</span>
        <h3>Wear</h3>
        <p>Soft shell. Sits like an ordinary cap.</p>
      </li>
      <li class="hs-reveal">
        <span class="hs-steps__num">03</span>
        <h3>Carry on</h3>
        <p>Coffee, email, the dog. The session happens anyway.</p>
      </li>
    </ol>
  </section>

  <section class="hs-close">
    <div class="hs-close__inner hs-reveal">
      <h2 class="hs-h2">Most devices end up in a drawer.</h2>
      <p class="hs-close__p">This one doesn&rsquo;t ask you to sit still.</p>
      <div class="hs-cta hs-cta--center">
        <a class="hs-btn hs-btn--primary" href="{{ p.url }}">Buy now &mdash; {{ p.price | money }}</a>
        <a class="hs-btn hs-btn--ghost" href="/pages/how-it-works">How it works</a>
      </div>
    </div>
  </section>
</div>

<style>
  .hs{--ink:#111111;--paper:#FFFFFF;--soft:#F7F7F6;--line:#E5E5E3;--accent:#D92D20;--muted:#6B6B6B;
      color:var(--ink);background:var(--paper);}
  .hs *{box-sizing:border-box;}
  .hs h1,.hs h2,.hs h3{margin:0;text-transform:none;}
  .hs p{margin:0;}

  .hs-eyebrow{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);
      font-weight:700;margin-bottom:1.1rem;}
  .hs-h1{font-size:clamp(2.1rem,6.4vw,3.7rem);line-height:1.03;letter-spacing:-.025em;font-weight:700;}
  .hs-h2{font-size:clamp(1.5rem,3.6vw,2.2rem);line-height:1.14;letter-spacing:-.02em;font-weight:700;}

  /* Hero */
  .hs-hero{position:relative;overflow:hidden;padding:clamp(2rem,6vw,4.5rem) 0;}
  .hs-hero__glow{position:absolute;top:-16%;right:-20%;width:min(720px,105vw);aspect-ratio:1;
      border-radius:50%;pointer-events:none;
      background:radial-gradient(circle,rgba(217,45,32,.16) 0%,rgba(217,45,32,.06) 44%,transparent 70%);
      animation:hs-pulse 7s ease-in-out infinite;}
  .hs-hero__inner{position:relative;display:grid;gap:clamp(1.75rem,4vw,3rem);align-items:center;
      grid-template-columns:1fr;max-width:1180px;margin:0 auto;padding:0 clamp(1.25rem,4vw,3rem);}
  .hs-hero__media img{display:block;width:100%;height:auto;border-radius:12px;border:1px solid var(--line);}
  .hs-price{font-size:clamp(1.5rem,3vw,2rem);font-weight:700;margin:1.4rem 0 1.5rem;letter-spacing:-.02em;}
  .hs-micro{margin-top:1rem;font-size:.85rem;color:var(--muted);}

  /* Buttons */
  .hs-cta{display:flex;flex-wrap:wrap;gap:.7rem;}
  .hs-cta--center{justify-content:center;}
  .hs-btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;
      padding:.95rem 1.7rem;border-radius:8px;font-weight:600;font-size:.98rem;line-height:1;
      border:1.5px solid transparent;
      transition:transform .18s ease,box-shadow .18s ease,background .18s ease,color .18s ease;}
  .hs-btn--primary{background:var(--accent);color:#fff;border-color:var(--accent);}
  .hs-btn--primary:hover,.hs-btn--primary:focus-visible{background:#B92418;border-color:#B92418;}
  .hs-btn--ghost{background:transparent;color:var(--ink);border-color:var(--ink);}
  .hs-btn--ghost:hover,.hs-btn--ghost:focus-visible{background:var(--ink);color:#fff;}
  .hs-btn:hover,.hs-btn:focus-visible{transform:translateY(-2px);box-shadow:0 8px 20px rgba(17,17,17,.14);}

  /* Strip */
  .hs-strip{background:var(--soft);border-block:1px solid var(--line);}
  .hs-strip__list{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem 1rem;list-style:none;
      margin:0 auto;padding:clamp(1.75rem,4vw,2.5rem) clamp(1.25rem,4vw,3rem);max-width:1180px;}
  .hs-strip__list li{display:flex;flex-direction:column;gap:.3rem;}
  .hs-strip__n{font-size:clamp(1.6rem,4vw,2.3rem);font-weight:700;line-height:1;letter-spacing:-.03em;
      color:var(--accent);}
  .hs-strip__l{font-size:.76rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:600;}

  /* Steps */
  .hs-steps{max-width:1180px;margin:0 auto;padding:clamp(2.75rem,7vw,4.5rem) clamp(1.25rem,4vw,3rem);}
  .hs-steps__list{list-style:none;margin:2rem 0 0;padding:0;display:grid;gap:1rem;grid-template-columns:1fr;}
  .hs-steps__list li{background:var(--paper);border:1px solid var(--line);border-radius:12px;
      padding:1.6rem 1.4rem;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;}
  .hs-steps__list li:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(17,17,17,.08);
      border-color:#D5D5D2;}
  .hs-steps__num{display:block;font-size:.78rem;letter-spacing:.14em;color:var(--accent);font-weight:700;
      margin-bottom:.6rem;}
  .hs-steps__list h3{font-size:1.15rem;margin-bottom:.35rem;font-weight:700;}
  .hs-steps__list p{color:var(--muted);font-size:.95rem;line-height:1.5;}

  /* Close */
  .hs-close{background:var(--ink);color:#fff;}
  .hs-close__inner{max-width:720px;margin:0 auto;text-align:center;
      padding:clamp(2.75rem,7vw,4.5rem) clamp(1.25rem,4vw,3rem);}
  .hs-close .hs-h2{color:#fff;}
  .hs-close__p{color:#B4B4B2;margin:.7rem 0 1.6rem;font-size:1.02rem;}
  .hs-close .hs-btn--ghost{color:#fff;border-color:rgba(255,255,255,.55);}
  .hs-close .hs-btn--ghost:hover{background:#fff;color:var(--ink);border-color:#fff;}

  @media(min-width:750px){
    .hs-hero__inner{grid-template-columns:1.05fr .95fr;}
    .hs-strip__list{grid-template-columns:repeat(4,1fr);}
    .hs-steps__list{grid-template-columns:repeat(3,1fr);gap:1.25rem;}
  }

  /* Motion */
  @keyframes hs-pulse{0%,100%{opacity:.6;transform:scale(1);}50%{opacity:1;transform:scale(1.07);}}
  .hs-reveal{opacity:0;transform:translateY(18px);
      transition:opacity .7s cubic-bezier(.2,.7,.3,1),transform .7s cubic-bezier(.2,.7,.3,1);}
  .hs-reveal--slow{transition-delay:.12s;}
  .hs-reveal.is-in{opacity:1;transform:none;}
  .hs-strip__list li.hs-reveal:nth-child(2){transition-delay:.08s;}
  .hs-strip__list li.hs-reveal:nth-child(3){transition-delay:.16s;}
  .hs-strip__list li.hs-reveal:nth-child(4){transition-delay:.24s;}
  .hs-steps__list li.hs-reveal:nth-child(2){transition-delay:.1s;}
  .hs-steps__list li.hs-reveal:nth-child(3){transition-delay:.2s;}

  @media(prefers-reduced-motion:reduce){
    .hs-reveal{opacity:1;transform:none;transition:none;}
    .hs-hero__glow{animation:none;}
    .hs-btn,.hs-steps__list li{transition:none;}
    .hs-btn:hover,.hs-steps__list li:hover{transform:none;}
  }
</style>

<script>
  (function(){
    var els = document.querySelectorAll('.hs .hs-reveal');
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function(el){ el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    els.forEach(function(el){ io.observe(el); });
  })();
</script>
